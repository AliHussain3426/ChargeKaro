# Frontend (Vite) environment variables
# Base URL for API requests (defaults to /api when omitted, using Vite proxy in dev).
# Use VITE_API_BASE_URL for the backend API base. Keep /api for same-origin proxy setups.
VITE_API_BASE_URL=/api

# Optional: absolute backend origin used for browser redirects to Google OAuth.
# Leave empty when VITE_API_BASE_URL is already an absolute URL (e.g. https://api.example.com/api).
# VITE_BACKEND_URL=http://localhost:5000
